rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helpers for band (agenda) access control.
    function bandData(bandId) {
      return get(/databases/$(database)/documents/bands/$(bandId)).data;
    }
    function isBandMember(bandId) {
      return isAuth() && request.auth.uid in bandData(bandId).memberUids;
    }
    function isBandOwner(bandId) {
      return isAuth() && request.auth.uid == bandData(bandId).ownerId;
    }
    // Leaders = owner plus anyone promoted into leaderUids (optional field).
    function isBandLeader(bandId) {
      return isAuth() && (
        request.auth.uid == bandData(bandId).ownerId ||
        ('leaderUids' in bandData(bandId) && request.auth.uid in bandData(bandId).leaderUids)
      );
    }
    // Invitee self-join: an invited e-mail may add ONLY its own uid to the band,
    // removing its own e-mail from invitedEmails and linking memberIdByUid.
    function isBandSelfJoin(bandId) {
      return isAuth()
        && request.auth.token.email != null
        && request.auth.token.email in bandData(bandId).invitedEmails
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'invitedEmails', 'memberIdByUid', 'updatedAt'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.token.email in request.resource.data.invitedEmails);
    }
    // Invitee decline: an invited e-mail may only pull itself from invitedEmails.
    function isBandSelfDecline(bandId) {
      return isAuth()
        && request.auth.token.email != null
        && request.auth.token.email in bandData(bandId).invitedEmails
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['invitedEmails', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids
        && !(request.auth.token.email in request.resource.data.invitedEmails);
    }
    // A member may only flip the status/comment of THEIR OWN assignment on an
    // event, identified via the band's memberIdByUid reverse index.
    function editsOwnEventStatus(bandId) {
      let mid = bandData(bandId).memberIdByUid[request.auth.uid];
      return 'memberIdByUid' in bandData(bandId)
        && request.auth.uid in bandData(bandId).memberIdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        && mid in resource.data.members
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([mid])
        && request.resource.data.members[mid].memberId == resource.data.members[mid].memberId
        && request.resource.data.members[mid].role == resource.data.members[mid].role;
    }


    // Users collection
    match /users/{userId} {
      // Anyone can read public profiles
      allow read: if true;

      allow create: if isAuth() && request.auth.uid == userId && (
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'admin' && request.auth.token.email != null && request.auth.token.email == 'jfreire.comercial@gmail.com')
      );

      // Users can update their own non-role fields
      // Only admins can change roles
      allow update: if isAuth() && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      // Admins can update any field including role
      allow update: if isAdmin();

      // Only admins can delete users
      allow delete: if isAdmin();

      // Dados sensíveis (CPF/CNPJ e endereço completo) ficam fora do
      // documento público, legíveis apenas pelo dono e por admins.
      // Path restrito ao documento único "profile" para evitar a criação
      // de documentos arbitrários na subcoleção.
      match /private/profile {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Products collection
    match /products/{productId} {
      // Public can read only moderated (approved/active) products. Unmoderated
      // products (pending/rejected) are visible only to the owner and admins.
      allow read: if resource.data.status == 'approved'
                  || resource.data.status == 'active'
                  || (isAuth() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Authenticated users can create products
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;

      // Sellers can update their own products
      // Admins can update any product (moderation)
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Sellers can soft-delete
      // Admins can delete any product
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Luthiers collection
    match /luthiers/{luthierId} {
      // Anyone can read luthier profiles
      allow read: if true;

      // Only authenticated luthiers can create their profile
      allow create: if isAuth() && request.auth.uid == luthierId;

      // Luthiers can update their own profile
      allow update: if isAuth() && request.auth.uid == luthierId;

      allow delete: if isAdmin();
    }

    // Teachers collection
    match /teachers/{teacherId} {
      // Anyone can read teacher profiles
      allow read: if true;

      // Only authenticated teachers can create their profile
      allow create: if isAuth() && request.auth.uid == teacherId;

      // Teachers can update their own profile
      allow update: if isAuth() && request.auth.uid == teacherId;

      allow delete: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // Users can read their own appointments (as client or luthier)
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.luthierId == request.auth.uid ||
        isAdmin()
      );

      // Authenticated users can create appointments
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;

      // Clients or luthiers can update their appointments
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.luthierId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // Chats collection
    match /chats/{chatId} {
      // Only participants can read the chat (allow read if doc doesn't exist yet for getDoc checks)
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participants);

      // Authenticated users can create chats
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;

      // Participants can update the chat
      allow update: if isAuth() && request.auth.uid in resource.data.participants;

      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);

        // Participants can send messages (com limite de tamanho contra abuso)
        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000 &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);

        allow update, delete: if false;
      }
    }

    // Proposals collection
    match /proposals/{proposalId} {
      // Sender or receiver can read the proposal
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );

      // Authenticated users can create proposals
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;

      // Sender or receiver can update proposal status
      allow update: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      allow delete: if false;
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      // Readable only by the user who favorited (userId) or the product's
      // seller (sellerId, for "who favorited my ad") — not by any auth user.
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.sellerId
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // Ratings subcollection (under products)
    match /products/{productId}/ratings/{ratingId} {
      // Anyone can read ratings
      allow read: if true;

      // Authenticated users can create ratings (but not their own product)
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid;

      // Users can update their own rating
      allow update: if isAuth() && resource.data.userId == request.auth.uid;

      // Only admins can delete ratings
      allow delete: if isAdmin();
    }

    // Top-level Profile Ratings collection
    match /ratings/{ratingId} {
      // Anyone can read ratings
      allow read: if true;

      // Authenticated users can create ratings (but not for themselves)
      // Must be linked to an accepted proposal (concluded sale)
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.proposalId is string
        && get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.receiverId == request.auth.uid;

      // Only admins can update (approve/reject) or delete profile ratings
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Verifications collection
    match /verifications/{verificationId} {
      // Users can read their own verification
      // Admins can read all verifications
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Authenticated users can create their own verification request
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;

      // Only admins can update verification status
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Banners collection (carrossel da home). Sem esta regra o catch-all
    // nega a leitura e o BannerCarousel sempre cai no fallback local.
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // Social: Posts collection
    // ==========================================
    match /posts/{postId} {
      // Posts are public
      allow read: if true;

      // Authenticated users can create posts (userId must match)
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      // Post owner can update any field; any auth user can update only reactions
      allow update: if isAuth()
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'totalReactions']));

      // Post owner or admin can delete
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // Social: User Favorites (follow profiles)
    // ==========================================
    match /userFavorites/{favId} {
      // Any authenticated user can read favorites
      allow read: if isAuth();

      // Users can create their own follow entries
      allow create: if isAuth()
        && request.resource.data.followerId == request.auth.uid;

      // Followers can only toggle notifyEnabled
      allow update: if isAuth()
        && resource.data.followerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyEnabled']);

      // Followers can unfollow
      allow delete: if isAuth()
        && resource.data.followerId == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Authenticated users can create notifications (e.g. when favoriting).
      // Valida o formato para limitar abuso (payloads gigantes / tipos arbitrários).
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.type in ['favorite', 'proposal', 'rating', 'system', 'new_post', 'new_follower']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.read == false;
      // Users can update (read/unread) and delete their own notifications
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // Agenda: Bands and their scheduling data
    // ==========================================
    match /bands/{bandId} {
      // Only the owner and listed members can see the band.
      allow read: if isBandOwner(bandId) || isBandMember(bandId);

      // Creator must be the owner and must include themselves as a member.
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      // Owner has full control. Co-leaders manage everything except ownership
      // and the leadership roster. Invitees may self-join or self-decline.
      allow update: if isBandOwner(bandId)
        || (isBandLeader(bandId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'leaderUids']))
        || isBandSelfJoin(bandId)
        || isBandSelfDecline(bandId);
      allow delete: if isBandOwner(bandId);

      // Repertoire: any member can manage songs.
      match /songs/{songId} {
        allow read: if isBandMember(bandId);
        allow write: if isBandMember(bandId);
      }

      // Roster: leaders add/edit/remove members. An invitee may link their own
      // uid onto the member entry matching their e-mail (accept flow).
      match /members/{memberId} {
        allow read: if isBandMember(bandId);
        allow write: if isBandLeader(bandId);
        allow update: if isAuth()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'status'])
          && request.resource.data.uid == request.auth.uid;
      }

      // Schedule: leaders create/remove/edit escalas; a member may only flip the
      // status/comment of their own assignment.
      match /events/{eventId} {
        allow read: if isBandMember(bandId);
        allow create, delete: if isBandLeader(bandId);
        allow update: if isBandLeader(bandId)
          || (isBandMember(bandId) && editsOwnEventStatus(bandId));
      }

      // Availability blocks: a member manages their own blocks.
      match /availability/{availabilityId} {
        allow read: if isBandMember(bandId);
        allow create: if isBandMember(bandId)
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isBandMember(bandId)
          && resource.data.uid == request.auth.uid;
      }
    }

    // ==========================================
    // Agenda: band invites (discovery index)
    // ==========================================
    // Lives outside the band so an invitee (not yet a member) can find their own
    // invites by e-mail. A leader creates/cancels invites; the invitee reads
    // their own and may only flip status to accepted/declined.
    match /bandInvites/{inviteId} {
      allow read: if isAuth() && (
        request.auth.token.email == resource.data.email ||
        isBandLeader(resource.data.bandId)
      );
      allow create: if isBandLeader(request.resource.data.bandId)
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.bandId is string
        && request.resource.data.memberId is string;
      allow update: if isAuth()
        && request.auth.token.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isBandLeader(resource.data.bandId);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

